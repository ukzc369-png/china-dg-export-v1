{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/cases",
      "destination": "/shandong-supply-base",
      "permanent": true
    },
    {
      "source": "/services",
      "destination": "/export-support",
      "permanent": true
    },
    {
      "source": "/markets",
      "destination": "/shandong-supply-base",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/"
    },
    {
      "source": "/admin/:path*",
      "destination": "/"
    }
  ]
}
